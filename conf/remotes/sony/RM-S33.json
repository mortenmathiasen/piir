{
    "description": "irr (LIRC remote)",
    "source": {"lirc-remotes": "remotes/sony/RM-S33.lircd.conf", "remote": "irr", "converter": "tools/lirc2piir.py 1.1"},
    "frequency": 38000,
    "dutycycle": 0.5,
    "transmitter": {"outpin": 17},
    "symboldefinitions": {
	"A": {"mark": 1240, "space": 0},
	"B": {"mark": 639, "space": 0},
	"H": {"mark": 2462, "space": 550},
	"1": {"mark": 1240, "space": 558},
	"0": {"mark": 639, "space": 558},
	"-": {"mark": 0, "space": 0}
    },
    "template": "-------------",
    "features": {
	"key": {
	    "KEY_POWER": "H10101000000A",
	    "KEY_SLEEP": "H00000110000A",
	    "Function": "H10010110011B",
	    "MD_Play": "H01010101111B",
	    "MD_Pause": "H10010101111B",
	    "MD_Stop": "H00010101111B",
	    "CD_Play": "H01001101000A",
	    "CD_Pause": "H10011101000A",
	    "CD_Stop": "H00011101000A",
	    "CD_Previous": "H00001101000A",
	    "CD_Next": "H10001101000A",
	    "CD_Rewind": "H11001101000A",
	    "CD_Forward": "H00101101000A",
	    "CD_Repeat": "H00110101000A",
	    "CD_Edit": "H01010111000A",
	    "CD_Check": "H10110001000A",
	    "CD_Clear": "H11110001000A",
	    "Tuner_Band": "H11110001011B",
	    "Tuner_Preset+": "H00001001011B",
	    "Tuner_Preset-": "H10001001011B",
	    "Tape_PlayBackward": "H11101100000A",
	    "Tape_PlayForward": "H01001100000A",
	    "Tape_Stop": "H00011100000A",
	    "Tape_Rewind": "H11001100000A",
	    "Tape_Forward": "H00101100000A"
	}
    }
}
