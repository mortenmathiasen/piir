{
    "description": "VCR (LIRC remote)",
    "source": {"lirc-remotes": "remotes/panasonic/VCR.lircd.conf", "remote": "VCR", "converter": "tools/lirc2piir.py 1.1"},
    "frequency": 36000,
    "dutycycle": 0.5,
    "transmitter": {"outpin": 17},
    "symboldefinitions": {
	"A": {"mark": 400, "space": 0},
	"H": {"mark": 4000, "space": 1600},
	"1": {"mark": 400, "space": 1200},
	"0": {"mark": 400, "space": 400},
	"V": {"mark": 0, "space": 10000},
	"W": {"mark": 0, "space": 1000},
	"-": {"mark": 0, "space": 0}
    },
    "template": "--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------",
    "features": {
	"key": {
	    "KEY_POWER": "",
	    "PAUSE/STILL": "",
	    "KEY_STOP": "",
	    "STILL_ADV": "",
	    "KEY_REWIND": "",
	    "KEY_PLAY": "",
	    "KEY_FASTFORWARD": "",
	    "KEY_RECORD": "",
	    "KEY_SLOW": "",
	    "SLOW-": "",
	    "SLOW+": "",
	    "SLP/SP": "",
	    "VCR/TV": "",
	    "KEY_CHANNELDOWN": "",
	    "KEY_CHANNELUP": "",
	    "INPUT_SELECT": "",
	    "MEMORY_PLAY": "",
	    "AUDIO_OUT": "",
	    "MONITOR": "",
	    "CLOCK/COUNTER": "",
	    "TAPE_REMAIN": "",
	    "RESET": ""
	}
    }
}
