	"W": {"mark": 0, "space": 1000},
	"X": {"mark": 0, "space": 100},
	"Y": {"mark": 0, "space": 10},
	"Z": {"mark": 0, "space": 1},
	"-": {"mark": 0, "space": 0}
    },
    "template": "-------------------------------------------------------------------------------",
    "features": {
	"key": {
	    "DISC": "H01010011000AVVWWWWWXXXXXXXYYYYYZH01010011000AVVWWWWWXXXXXXXYYYYYZH01010011000A",
