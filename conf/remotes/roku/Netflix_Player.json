	    "KEY_DOWN": "H01111101111101111010000001011111A",
	    "KEY_LEFT": "H01111101111101110100000010111111A",
	    "KEY_RIGHT": "H01111101111101110010000011011111A",
	    "KEY_OK": "H01111101111101111100000000111111A",
	    "KEY_REWIND": "H01111101111101110110000010011111A",
	    "KEY_FORWARD": "H01111101111101110001000011101111A",
	    "KEY_PLAY": "H01111101111101111110000000011111A"
	}
    }
}
