	"X": {"mark": 0, "space": 100},
	"Y": {"mark": 0, "space": 10},
	"-": {"mark": 0, "space": 0}
    },
    "template": "---------------------------------------------------------------------",
    "features": {
	"key": {
	    "Mute": "H00101000000AVVWWWWWXXXYYYYYH00101000000AVVWWWWWXXXYYYYYH00101000000A",
	    "Vol_up": "H01001000000AVVWWWWWXXXYYYYYH01001000000AVVWWWWWXXXYYYYYH01001000000A",
