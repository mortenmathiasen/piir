{
    "description": "AMP (LIRC remote)",
    "source": {"lirc-remotes": "remotes/panasonic/AMP.lircd.conf", "remote": "AMP", "converter": "tools/lirc2piir.py 1.0"},
    "frequency": 36000,
    "dutycycle": 0.5,
    "transmitter": {"outpin": 17},
    "symboldefinitions": {
	"A": {"mark": 400, "space": 0},
	"H": {"mark": 4000, "space": 1600},
	"1": {"mark": 400, "space": 1200},
	"0": {"mark": 400, "space": 400},
	"V": {"mark": 0, "space": 10000},
	"W": {"mark": 0, "space": 1000},
	"-": {"mark": 0, "space": 0}
    },
    "template": "-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------",
    "features": {
	"key": {
	    "KEY_POWER": "",
	    "KEY_VOLUMEUP": "",
	    "KEY_VOLUMEDOWN": "",
	    "KEY_SLEEP": "",
	    "DISPLAY": ""
	}
    }
}
